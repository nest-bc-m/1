rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all documents
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Academic Programs (Courses)
    match /programs/{programId} {
      allow read: if true;
      allow create, update, delete: if isSignedIn() && isValidId(programId);
    }

    // Institutional Announcements and Bulletins
    match /announcements/{announcementId} {
      allow read: if true;
      allow create, update, delete: if isSignedIn() && isValidId(announcementId);
    }

    // Faculty Directory
    match /faculty/{facultyId} {
      allow read: if true;
      allow create, update, delete: if isSignedIn() && isValidId(facultyId);
    }

    // General Institutional Website Content
    match /content/{contentId} {
      allow read: if true;
      allow create, update, delete: if isSignedIn() && isValidId(contentId);
    }

    // Candidate Admission Inquiries
    match /admissions/{admissionId} {
      allow read, update, delete: if isSignedIn() && isValidId(admissionId);
      allow create: if isValidId(admissionId)
        && request.resource.data.fullName is string
        && request.resource.data.fullName.size() > 0
        && request.resource.data.fullName.size() <= 150
        && request.resource.data.phone is string
        && request.resource.data.phone.size() > 0
        && request.resource.data.phone.size() <= 50;
    }

    // Connection testing
    match /test/connection {
      allow read: if true;
    }
  }
}
