{
  "entities": {
    "Program": {
      "title": "Program",
      "description": "Academic theological degree and diploma courses offered by NEST",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "titleEn": { "type": "string", "maxLength": 200 },
        "titleKn": { "type": "string", "maxLength": 200 },
        "levelEn": { "type": "string", "maxLength": 100 },
        "levelKn": { "type": "string", "maxLength": 100 },
        "durationEn": { "type": "string", "maxLength": 100 },
        "durationKn": { "type": "string", "maxLength": 100 },
        "mediumEn": { "type": "string", "maxLength": 100 },
        "mediumKn": { "type": "string", "maxLength": 100 },
        "descriptionEn": { "type": "string", "maxLength": 1000 },
        "descriptionKn": { "type": "string", "maxLength": 1000 },
        "eligibilityEn": { "type": "string", "maxLength": 500 },
        "eligibilityKn": { "type": "string", "maxLength": 500 },
        "category": { "type": "string", "maxLength": 50 },
        "isAvailable": { "type": "boolean" }
      },
      "required": ["id", "titleEn", "category"]
    },
    "Announcement": {
      "title": "Announcement",
      "description": "Official college bulletins, notices, and exam schedules",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "titleEn": { "type": "string", "maxLength": 300 },
        "titleKn": { "type": "string", "maxLength": 300 },
        "date": { "type": "string", "maxLength": 50 },
        "badgeEn": { "type": "string", "maxLength": 50 },
        "badgeKn": { "type": "string", "maxLength": 50 },
        "isUrgent": { "type": "boolean" },
        "isActive": { "type": "boolean" }
      },
      "required": ["id", "titleEn", "date", "isActive"]
    },
    "Faculty": {
      "title": "Faculty",
      "description": "Theological faculty instructors, dean, and mentors",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "nameEn": { "type": "string", "maxLength": 150 },
        "nameKn": { "type": "string", "maxLength": 150 },
        "roleEn": { "type": "string", "maxLength": 150 },
        "roleKn": { "type": "string", "maxLength": 150 },
        "qualificationEn": { "type": "string", "maxLength": 150 },
        "qualificationKn": { "type": "string", "maxLength": 150 },
        "specializationEn": { "type": "string", "maxLength": 200 },
        "specializationKn": { "type": "string", "maxLength": 200 },
        "bioEn": { "type": "string", "maxLength": 1000 },
        "bioKn": { "type": "string", "maxLength": 1000 },
        "isFeatured": { "type": "boolean" }
      },
      "required": ["id", "nameEn", "roleEn"]
    },
    "InstitutionContent": {
      "title": "InstitutionContent",
      "description": "General institutional profile, contact details, motto, and leadership",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "principal": { "type": "string", "maxLength": 150 },
        "phone": { "type": "string", "maxLength": 50 },
        "email": { "type": "string", "maxLength": 150 },
        "address": { "type": "string", "maxLength": 300 },
        "motto": { "type": "string", "maxLength": 300 },
        "mottoScripture": { "type": "string", "maxLength": 150 }
      },
      "required": ["id", "principal", "phone", "email"]
    },
    "AdmissionInquiry": {
      "title": "AdmissionInquiry",
      "description": "Student candidate applications and admission inquiries",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "fullName": { "type": "string", "maxLength": 150 },
        "phone": { "type": "string", "maxLength": 50 },
        "email": { "type": "string", "maxLength": 150 },
        "programId": { "type": "string", "maxLength": 50 },
        "programName": { "type": "string", "maxLength": 150 },
        "cityState": { "type": "string", "maxLength": 150 },
        "qualification": { "type": "string", "maxLength": 150 },
        "churchName": { "type": "string", "maxLength": 150 },
        "callingBrief": { "type": "string", "maxLength": 1000 },
        "housingNeeded": { "type": "boolean" },
        "status": { "type": "string", "maxLength": 50 }
      },
      "required": ["id", "fullName", "phone", "programId"]
    }
  },
  "firestore": {
    "/programs/{programId}": {
      "schema": "Program",
      "description": "Academic degree and diploma courses"
    },
    "/announcements/{announcementId}": {
      "schema": "Announcement",
      "description": "Institutional updates and announcements"
    },
    "/faculty/{facultyId}": {
      "schema": "Faculty",
      "description": "Theological faculty and instructional mentors"
    },
    "/content/{contentId}": {
      "schema": "InstitutionContent",
      "description": "Institutional profile and general website content"
    },
    "/admissions/{admissionId}": {
      "schema": "AdmissionInquiry",
      "description": "Student admissions and inquiries"
    }
  }
}
